# ========================================================
# SmartPDF Environment Configuration
# Copy this file to .env and configure as needed
# ========================================================

# Application Mode: development | production
APP_ENV=production

# Storage Paths (relative to SmartPDF root or absolute)
STORAGE_DIR=storage
DB_PATH=storage/smartpdf.db

# Cloud LLM API Keys (Optional - Retrieval and Extractive features work without keys)
# Supported providers: GEMINI, GROQ, OPENAI, OLLAMA
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Local Quantized LLM (Optional - Disabled by default to protect 8 GB RAM)
ENABLE_LOCAL_LLM=false
LOCAL_LLM_MODEL_PATH=

# Tesseract OCR Executable Path (Optional for scanned PDFs)
# Default Windows path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Memory Optimization Flags
MAX_UPLOAD_SIZE_MB=35
MAX_CHUNKS_PER_RETRIEVAL=5
EMBEDDING_BATCH_SIZE=16
MEMORY_WARNING_THRESHOLD_PERCENT=82.0

